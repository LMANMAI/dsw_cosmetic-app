{
  "expo": {
    "name": "YOFI",
    "slug": "beautyapp",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "beautyapp",
    "userInterfaceStyle": "light",
   "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1724"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.beautyapp.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BeautyApp usa tu ubicacion para mostrarte profesionales cercanas."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyAgOCvjEyoaORimtnp_liqc2xzuAVGjj78"
      }
    },
    "android": {
      "package": "com.beautyapp.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#B84968"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAgOCvjEyoaORimtnp_liqc2xzuAVGjj78"
        }
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "BeautyApp usa tu ubicacion para mostrarte profesionales cercanas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://api.beautyapp.local",
      "google": {
        "webClientId": "410806601848-m0fo806e5p0hqbvcu6lc776ih0hlu8o5.apps.googleusercontent.com",
        "iosClientId": null
      },
      "router": {},
      "eas": {
        "projectId": "285d6d01-7840-4287-855c-93e8dd969bc3"
      }
    }
  }
}
