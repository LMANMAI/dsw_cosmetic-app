{
  "name": "beautyapp",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev:android": "expo run:android",
    "dev:ios": "expo run:ios",
    "build:dev": "eas build -p android --profile development",
    "build:dev:ios": "eas build -p ios --profile development",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "generate": "eas build -p android --profile preview",
    "generate:prod": "eas build -p android --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.0",
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "expo": "~54.0.0",
    "expo-auth-session": "~7.0.0",
    "expo-constants": "~18.0.0",
    "expo-crypto": "~15.0.0",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.0",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.0",
    "expo-linking": "~8.0.0",
    "expo-location": "~19.0.0",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.0",
    "expo-splash-screen": "~31.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-system-ui": "~6.0.0",
    "expo-web-browser": "~15.0.0",
    "firebase": "^11.0.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.6.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "firebase-admin": "^14.3.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
